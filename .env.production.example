# ─────────────────────────────────────────────────────────────────
#  WATHBA — Production Environment Variables (VPS / Docker)
#  انسخ الملف ده لـ .env وعبي القيم الحقيقية
#  cp .env.production.example .env
# ─────────────────────────────────────────────────────────────────

# ── PostgreSQL (Docker internal) ──────────────────────────────────
POSTGRES_DB=wathba
POSTGRES_USER=wathba
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_HERE

# ── Auth ──────────────────────────────────────────────────────────
# غير القيمة دي لـ string عشوائي طويل (على الأقل 64 حرف)
# ممكن تولده بـ: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_MIN_64_CHARS

# ── Domain ────────────────────────────────────────────────────────
WILDCARD_DOMAIN=wathba.site
ALLOWED_ORIGINS=https://wathba.site,https://admin.wathba.site

# ── Firebase (اختياري — للـ push notifications) ──────────────────
# لو مش هتستخدم FCM، سيبه فاضي
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── LiveKit (اختياري — للـ live streaming) ────────────────────────
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_URL=wss://live.wathba.site
